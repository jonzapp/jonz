{
  "name": "jonz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api --",
    "dev:client": "npm run start -w apps/client --",
    "build": "npm run build -w apps/api --",
    "start": "npm run start -w apps/api --",
    "lint": "eslint \"scripts/**/*.test.ts\" && npm run lint --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && vitest run",
    "test:watch": "npm run test:watch -w @app/core",
    "test:db": "npm run test:db -w @app/server -w v1 && npm run test:db -w apps/api --",
    "openapi": "npm run openapi -w v1",
    "test:all": "npm test && npm run test:db",
    "test:e2e": "npm run test:e2e -w apps/api --",
    "tick": "node scripts/tick.mjs",
    "provision": "node scripts/provision.mjs",
    "vapid": "node scripts/vapid.mjs",
    "brand": "node scripts/brand.mjs",
    "release:ios": "node scripts/release.mjs ios",
    "release:android": "node scripts/release.mjs android",
    "types": "supabase gen types typescript --local > packages/core/src/db-types.ts",
    "db:types": "npm run types",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:advisors": "supabase db advisors --local --type all --level warn --fail-on warn",
    "db:standards": "psql \"${DB_URL:-postgresql://postgres:postgres@127.0.0.1:54342/postgres}\" -q -f supabase/checks/standards.sql",
    "email:preview": "node scripts/email-preview.mjs",
    "code:standards": "node scripts/ci/code-standards.mjs",
    "package:chatgpt": "rm -f jonz-chatgpt.zip && cd integrations/chatgpt && zip -r ../../jonz-chatgpt.zip plugin.json mcp.json assets"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.110.0",
    "eslint": "^9",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.9",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "light-my-request": "6.6.0"
  }
}
