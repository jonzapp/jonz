# Copy to .env.local beside this file. EXPO_PUBLIC_ values are bundled into
# the app and visible to anyone: only the public URL and key belong here.
# `supabase status -o env` prints the local ones.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# apps/api, for the few moves that need a server. Needed on a phone; a web
# build without it calls /api on its own origin, as jonz.app does.
EXPO_PUBLIC_API_URL=http://localhost:3205
# Google sign-in on iOS and Android (public client IDs from Google Cloud;
# DEPLOYMENT.md says how to make them). The web build doesn't need them.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reminders on the web: the VAPID public key, the same one as apps/api's
# NEXT_PUBLIC_VAPID_PUBLIC_KEY. Without it House offers no reminders.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# Selling the House Pass on the web (Stripe Checkout through apps/api, which
# needs its STRIPE_ keys). Anything but `on` shows the plans and sells nothing.
EXPO_PUBLIC_PASS_CHECKOUT=
# Staging only (Vercel's Preview environment): `staging` shows the staging
# ribbon and the demo housemates' sign-in. Never set in production.
EXPO_PUBLIC_STAGE=
